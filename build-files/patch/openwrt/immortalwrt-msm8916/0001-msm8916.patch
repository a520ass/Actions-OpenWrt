+			  "",
+			  "",
+			  "AP_TS_PEN_I2C_SDA",
+			  "AP_TS_PEN_I2C_SCL",
+			  "DP_HOT_PLUG_DET",
+			  "EC_IN_RW_ODL";
+};
diff --git a/target/linux/msm89xx/dts/sc7180-trogdor-lte-sku.dtsi b/target/linux/msm89xx/dts/sc7180-trogdor-lte-sku.dtsi
